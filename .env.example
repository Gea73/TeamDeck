# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# For local development, configure this in .env.local or .env.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional override for the Gemini model ID used by PDF & preparation services.
GEMINI_MODEL="gemini-4-hydrogen"

# GOOGLE_TOKEN_VAULT_SECRET: Optional 32+ char secret for AES-256-GCM encryption of Google sessions.
# Required in multi-instance or persistent production deployments.
GOOGLE_TOKEN_VAULT_SECRET="CHANGE_ME_IN_PRODUCTION_32_CHAR_SECRET"

# APP_URL: The URL where this applet is hosted (used for CSRF Origin validation & links).
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string for development/production.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/teamdeck"

# TEST_DATABASE_URL: Separate PostgreSQL connection string strictly for automated tests.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/teamdeck_test"

# DATABASE_SSL: Set to "true" in managed PostgreSQL environments requiring TLS.
DATABASE_SSL="false"

